PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://<username>:<password>@localhost:5432/<db_name>?schema=public"

# JWT Secret Key
JWT_SECRET=

# Swagger Documentation Credentials
SWAGGER_USER=
SWAGGER_PASSWORD=

# ==============================================================================
# File Storage Configuration
# ==============================================================================
# Opsi STORAGE_DRIVER:
#   - 'local' : Menyimpan berkas ke disk server lokal (folder /uploads)
#   - 'r2'    : Menyimpan berkas ke Cloudflare R2 Object Storage
# ==============================================================================
STORAGE_DRIVER=local

# ==============================================================================
# Cloudflare R2 Credentials (Wajib diisi jika STORAGE_DRIVER=r2)
# ==============================================================================
# Endpoint URL R2 format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION="auto"
