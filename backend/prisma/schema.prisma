model SidangRegistrationPeriod {
  id                  String               @id @default(uuid())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  name                String
  startDate           DateTime             @map("start_date") @db.Date
  endDate             DateTime             @map("end_date") @db.Date
  isOpen              Boolean
  sidangRegistrations SidangRegistration[]
}

model SidangRegistration {
  id                          String                       @id @default(uuid())
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  deletedAt                   DateTime?
  // draft
  isDraft                     Boolean                      @default(true)
  mahasiswa                   Mahasiswa?                   @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId                 String?
  program                     String? // Reguler / Alih Jenjang
  dosenWali                   Dosen?                       @relation("WaliSidangRegistrations", fields: [dosenWaliId], references: [id]) // Dosen Wali 1
  dosenWaliId                 String?
  sks                         Int?
  ipk                         Float?
  tak                         Int?
  sktaExpDate                 DateTime?                    @map("skta_exp_date") @db.Date
  judulTugasAkhirIndonesia    String?
  judulTugasAkhirInggris      String?
  dosenPembimbing1            Dosen?                       @relation("Pembimbing1SidangRegistrations", fields: [dosenPembimbing1Id], references: [id]) // Dosen Pembimbing 1
  dosenPembimbing1Id          String?
  dosenPembimbing2            Dosen?                       @relation("Pembimbing2SidangRegistrations", fields: [dosenPembimbing2Id], references: [id]) // Dosen Pembimbing 2
  dosenPembimbing2Id          String?
  researchGroup               ResearchGroup?               @relation(fields: [researchGroupId], references: [id])
  researchGroupId             String?
  skemaSidang                 String? // Reguler, Non Sidang, Capstone, Sidang Khusus Prodi
  jalurNonSidang              String[] // Contoh isi JSON: ["Publikasi Jurnal", "Proceeding International", "HKI"]
  // submited
  submittedAt                 DateTime?
  sidangRegistrationPeriod    SidangRegistrationPeriod?    @relation(fields: [sidangRegistrationPeriodId], references: [id])
  sidangRegistrationPeriodId  String?
  // Setuju
  sidangPeriod                SidangPeriod?                @relation(fields: [sidangPeriodId], references: [id])
  sidangPeriodId              String?
  // Tolak Permohonan
  message                     String?
  isEdit                      DateTime?
  admin                       Admin                        @relation(fields: [adminId], references: [id])
  adminId                     String
  sidangRegistrationUploads   SidangRegistrationUpload[]
  sidangRegistrationResponses SidangRegistrationResponse[]
}

// Upload Dokumen Persyaratan
model SidangRegistrationUpload {
  id                   String             @id @default(uuid())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  // mahasiswa via sistem
  name                 String // Nama Berkas
  category             String
  filepath             String
  // admin
  isValid              Boolean?
  sidangRegistration   SidangRegistration @relation(fields: [sidangRegistrationId], references: [id], onDelete: Cascade)
  sidangRegistrationId String
}

model SidangRegistrationResponse {
  id                   String             @id @default(uuid())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  message              String?
  isEdit               DateTime?
  admin                Admin              @relation(fields: [adminId], references: [id])
  adminId              String
  sidangRegistration   SidangRegistration @relation(fields: [sidangRegistrationId], references: [id], onDelete: Cascade)
  sidangRegistrationId String
}

// Daftar Yudisium
model YudisiumPeriod {
  id                    String                 @id @default(uuid())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  category              String // tipe aktivitas: pendaftaran yudisium / yudisium
  period                String // nama periode: 2026/2027
  startDate             DateTime               @map("start_date") @db.Date
  endDate               DateTime               @map("end_date") @db.Date
  isOpen                Boolean                @default(false)
  yudisiumRegistrations YudisiumRegistration[]
}

