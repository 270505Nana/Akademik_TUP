model YudisiumRegistrationPeriod {
  id                    String                 @id @default(uuid())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  name                  String
  startDate             DateTime               @map("start_date") @db.Date
  endDate               DateTime               @map("end_date") @db.Date
  isOpen                Boolean
  yudisiumRegistrations YudisiumRegistration[]
}

model YudisiumRegistration {
  id                            String                         @id @default(uuid())
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  deletedAt                     DateTime?
  // draft
  isDraft                       Boolean                        @default(true)
  // wajib
  mahasiswa                     Mahasiswa?                     @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId                   String?
  program                       String? // Reguler / Alih Jenjang
  dosenWali                     Dosen?                         @relation("WaliYudisiumRegistrations", fields: [dosenWaliId], references: [id]) // Dosen Wali 1
  dosenWaliId                   String?
  judulTugasAkhirIndonesia      String?
  judulTugasAkhirInggris        String?
  tak                           Int?
  skemaSidang                   String? // Reguler, Non Sidang, Capstone, Sidang Khusus Prodi
  pengajuanCumlaude             String? // Non Cumlaude, Pengajuan Cumlaude, Pengajuan Summa Cumlaude
  skemaCumlaude                 String? // Publikasi Jurnal, Pameran, Lomba, HKI
  evidenCumlaude                String?                        @db.Text
  dosenPembimbing1              Dosen?                         @relation("Pembimbing1YudisiumRegistrations", fields: [dosenPembimbing1Id], references: [id]) // Dosen Pembimbing 1
  dosenPembimbing1Id            String? // di form yang baru tidak menyertakan Dospem 1
  dosenPembimbing2              Dosen?                         @relation("Pembimbing2YudisiumRegistrations", fields: [dosenPembimbing2Id], references: [id]) // Dosen Pembimbing 2
  dosenPembimbing2Id            String? // di form yang baru tidak menyertakan Dospem 2
  // submitted
  submittedAt                   DateTime?
  yudisiumRegistrationPeriod    YudisiumRegistrationPeriod?    @relation(fields: [yudisiumRegistrationPeriodId], references: [id])
  yudisiumRegistrationPeriodId  String?
  // Setuju
  yudisiumPeriod                YudisiumPeriod?                @relation(fields: [yudisiumPeriodId], references: [id])
  yudisiumPeriodId              String?
  // Tolak Permohonan
  message                       String?
  isEdit                        DateTime?
  admin                         Admin                          @relation(fields: [adminId], references: [id])
  adminId                       String
  yudisiumRegistrationUploads   YudisiumRegistrationUpload[]
  yudisiumRegistrationResponses YudisiumRegistrationResponse[]
}

// Upload Dokumen Persyaratan
model YudisiumRegistrationUpload {
  id                     String               @id @default(uuid())
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?
  // mahasiswa via sistem
  name                   String // Nama Berkas
  category               String // Evidence Cumlaude / Dokumen Kelengkapan Yudisium
  filepath               String
  // admin
  isValid                Boolean?
  yudisiumRegistration   YudisiumRegistration @relation(fields: [yudisiumRegistrationId], references: [id], onDelete: Cascade)
  yudisiumRegistrationId String
}

