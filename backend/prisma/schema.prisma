model BerkasMahasiswa {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  name        String // Nama Berkas
  category    String // SKL, Transkrip, Dokumen Validasi Skta, Formulir Penerbitan Skta
  filepath    String
  mahasiswa   Mahasiswa @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId String    @map("mahasiswa_id")

  @@map("berkas_mahasiswa")
}

