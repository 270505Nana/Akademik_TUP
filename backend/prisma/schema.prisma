// Daftar Sidang
model SidangPeriod {
  id                        String               @id @default(uuid())
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  deletedAt                 DateTime?            @map("deleted_at")
  name                      String
  category                  String // tipe aktivitas: pendaftaran sidang / sidang
  period                    String // nama periode: 2026/2027
  startDate                 DateTime             @map("start_date")
  endDate                   DateTime             @map("end_date")
  isOpen                    Boolean              @default(false) @map("is_open")
  sidangRegistrationPeriods SidangRegistration[] @relation("SidangRegistrationPeriod")
  sidangPeriods             SidangRegistration[] @relation("SidangPeriod")

  @@map("sidang_period")
}

