// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MAHASISWA
  DOSEN
  ADMIN
}

model User {
  id        String     @id @default(uuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  name      String
  email     String     @unique
  password  String
  phone     String?    @unique
  role      Role?
  admin     Admin?
  dosen     Dosen?
  mahasiswa Mahasiswa?
}

// Master Data Admin
model Admin {
  id                            String                         @id @default(uuid())
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  deletedAt                     DateTime?
  user                          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                        String                         @unique
  sktaResponses                 SktaResponse[]
  sidangRegistrationResponses   SidangRegistrationResponse[]
  yudisiumRegistrationResponses YudisiumRegistrationResponse[]
}

// Master Data Dosen
model ResearchGroup {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  name      String
  isActive  Boolean   @default(true)
  dosen     Dosen[]
}

model Dosen {
  id                               String                 @id @default(uuid())
  createdAt                        DateTime               @default(now())
  updatedAt                        DateTime               @updatedAt
  deletedAt                        DateTime?
  nip                              String                 @unique
  nidn                             String?                @unique
  kodeDosen                        String
  researchGroup                    ResearchGroup          @relation(fields: [researchGroupId], references: [id])
  researchGroupId                  String
  user                             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                           String                 @unique
  mahasiswa                        Mahasiswa[]
  pembimbing1SktaRequests          SktaRequest[]          @relation("Pembimbing1SktaRequests")
  pembimbing2SktaRequests          SktaRequest[]          @relation("Pembimbing2SktaRequests")
  pembimbing1SidangRegistrations   SidangRegistration[]   @relation("Pembimbing1SidangRegistrations")
  pembimbing2SidangRegistrations   SidangRegistration[]   @relation("Pembimbing2SidangRegistrations")
  pembimbing1YudisiumRegistrations YudisiumRegistration[] @relation("Pembimbing1YudisiumRegistrations")
  pembimbing2YudisiumRegistrations YudisiumRegistration[] @relation("Pembimbing2YudisiumRegistrations")
  pembimbing1Skta                  PermohonanSkta[]       @relation("Pembimbing1Skta")
  pembimbing2Skta                  PermohonanSkta[]       @relation("Pembimbing2Skta")
}

// Master Data Mahasiswa
model Faculty {
  id            String         @id @default(uuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  name          String
  isActive      Boolean        @default(true)
  studyPrograms StudyProgram[]
}

model StudyProgram {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  name      String
  isActive  Boolean     @default(true)
  faculty   Faculty     @relation(fields: [facultyId], references: [id])
  facultyId String
  mahasiswa Mahasiswa[]
}

model Mahasiswa {
  id                            String                         @id @default(uuid())
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  deletedAt                     DateTime?
  nim                           String                         @unique
  kelasAsal                     String
  tahunAngkatan                 Int
  sks                           Int?
  ipk                           Float?
  tak                           Int?
  studyProgram                  StudyProgram                   @relation(fields: [studyProgramId], references: [id])
  studyProgramId                String
  user                          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                        String                         @unique
  dosenWali                     Dosen                          @relation(fields: [dosenWaliId], references: [id])
  dosenWaliId                   String // Dosen Wali
  sktaRequests                  SktaRequest[]
  sidangRegistrations           SidangRegistration[]
  yudisiumRegistrations         YudisiumRegistration[]
  sktaResponses                 SktaResponse[]
  sktaResponseUploads           SktaResponseUpload[]
  sktaRequestUploads            SktaRequestUpload[]
  sklUploads                    SklUpload[]
  transkripUploads              TranskripUpload[]
  dokumenValidasiSktaUploads    DokumenValidasiSktaUpload[]
  formulirPenerbitanSktaUploads FormulirPenerbitanSktaUpload[]
  permohonanSktas               PermohonanSkta[]
}

// Permohonan Surat Keputusan TA
model PermohonanSkta {
  id                       String    @id @default(uuid())
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?
  judulProposalIndonesia   String // di form yang baru tidak menyertakan judulProposalIndonesia
  judulProposalInggris     String // di form yang baru tidak menyertakan judulProposalInggris
  evidenceUploadPath       String
  mahasiswa                Mahasiswa @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade) // NIM, Prodi, No HP
  mahasiswaId              String
  dosenPembimbing1         Dosen     @relation("Pembimbing1Skta", fields: [dosenPembimbing1Id], references: [id]) // Nama, Kode, Kelompok Keilmuan (Research Group) Dosen Pembimbing 1
  dosenPembimbing1Id       String
  dosenPembimbing2         Dosen     @relation("Pembimbing2Skta", fields: [dosenPembimbing2Id], references: [id]) // Nama, Kode Dosen Pembimbing 2
  dosenPembimbing2Id       String
  hasUploadedFinalProposal Boolean?
  hasTakenLanguageTest     Boolean?
  expDate                  DateTime? @db.Date
}

model SktaRequest {
  id                  String               @id @default(uuid())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  proposalTitleId     String
  proposalTitleEn     String
  mahasiswa           Mahasiswa            @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId         String
  dosenPembimbing1    Dosen                @relation("Pembimbing1SktaRequests", fields: [dosenPembimbing1Id], references: [id]) // Dosen Pembimbing 1
  dosenPembimbing1Id  String
  dosenPembimbing2    Dosen                @relation("Pembimbing2SktaRequests", fields: [dosenPembimbing2Id], references: [id]) // Dosen Pembimbing 2
  dosenPembimbing2Id  String
  sktaResponses       SktaResponse[]
  sktaResponseUploads SktaResponseUpload[]
  sktaRequestUploads  SktaRequestUpload[]
}

// Upload Evidence
model SktaRequestUpload {
  id            String      @id @default(uuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  name          String
  filename      String
  slug          String      @default("evidence")
  path          String
  mahasiswa     Mahasiswa?  @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId   String?
  sktaRequest   SktaRequest @relation(fields: [sktaRequestId], references: [id], onDelete: Cascade)
  sktaRequestId String
}

model SktaResponse {
  id                       String               @id @default(uuid())
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  deletedAt                DateTime?
  hasUploadedFinalProposal Boolean
  hasTakenLanguageTest     Boolean
  expDate                  DateTime?            @db.Date
  message                  String?
  isEdit                   DateTime?
  mahasiswa                Mahasiswa?           @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId              String?
  admin                    Admin                @relation(fields: [adminId], references: [id])
  adminId                  String
  sktaRequest              SktaRequest          @relation(fields: [sktaRequestId], references: [id], onDelete: Cascade)
  sktaRequestId            String
  sktaResponseUploads      SktaResponseUpload[]
}

// Upload SKTA
model SktaResponseUpload {
  id             String        @id @default(uuid())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  name           String
  filename       String
  slug           String        @default("skta")
  path           String
  mahasiswa      Mahasiswa?    @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId    String?
  sktaRequest    SktaRequest   @relation(fields: [sktaRequestId], references: [id], onDelete: Cascade)
  sktaRequestId  String
  sktaResponse   SktaResponse? @relation(fields: [sktaResponseId], references: [id], onDelete: Cascade)
  sktaResponseId String?
}

// Daftar Sidang
model SidangPeriod {
  id                  String               @id @default(uuid())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  name                String
  startDate           DateTime             @map("start_date") @db.Date
  endDate             DateTime             @map("end_date") @db.Date
  isOpen              Boolean
  sidangRegistrations SidangRegistration[]
}

model SidangRegistrationPeriod {
  id                  String               @id @default(uuid())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  name                String
  startDate           DateTime             @map("start_date") @db.Date
  endDate             DateTime             @map("end_date") @db.Date
  isOpen              Boolean
  sidangRegistrations SidangRegistration[]
}

model SidangRegistration {
  id                          String                       @id @default(uuid())
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  submittedAt                 DateTime?
  deletedAt                   DateTime?
  isDraft                     Boolean                      @default(true)
  programType                 String?
  sks                         Int?
  ipk                         Float?
  tak                         Int?
  sktaExpDate                 DateTime?                    @map("skta_exp_date") @db.Date
  thesisTitleId               String?
  thesisTitleEn               String?
  sidangScheme                String?
  jalurNonSidang              Json? // Contoh isi JSON: ["Publikasi Jurnal", "Proceeding International", "HKI"]
  mahasiswa                   Mahasiswa?                   @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId                 String?
  dosenPembimbing1            Dosen?                       @relation("Pembimbing1SidangRegistrations", fields: [dosenPembimbing1Id], references: [id]) // Dosen Pembimbing 1
  dosenPembimbing1Id          String?
  dosenPembimbing2            Dosen?                       @relation("Pembimbing2SidangRegistrations", fields: [dosenPembimbing2Id], references: [id]) // Dosen Pembimbing 2
  dosenPembimbing2Id          String?
  sidangPeriod                SidangPeriod?                @relation(fields: [sidangPeriodId], references: [id])
  sidangPeriodId              String?
  sidangRegistrationPeriod    SidangRegistrationPeriod?    @relation(fields: [sidangRegistrationPeriodId], references: [id])
  sidangRegistrationPeriodId  String?
  sidangRegistrationUploads   SidangRegistrationUpload[]
  sidangRegistrationResponses SidangRegistrationResponse[]
}

// Upload Dokumen Persyaratan
model SidangRegistrationUpload {
  id                   String             @id @default(uuid())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  name                 String
  filename             String
  slug                 String // misal: formValidasiDosenWali
  path                 String
  isValid              Boolean?
  sidangRegistration   SidangRegistration @relation(fields: [sidangRegistrationId], references: [id], onDelete: Cascade)
  sidangRegistrationId String
}

model SidangRegistrationResponse {
  id                   String             @id @default(uuid())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  message              String?
  isEdit               DateTime?
  admin                Admin              @relation(fields: [adminId], references: [id])
  adminId              String
  sidangRegistration   SidangRegistration @relation(fields: [sidangRegistrationId], references: [id], onDelete: Cascade)
  sidangRegistrationId String
}

// Daftar Yudisium
model YudisiumPeriod {
  id                    String                 @id @default(uuid())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  name                  String
  startDate             DateTime               @map("start_date") @db.Date
  endDate               DateTime               @map("end_date") @db.Date
  isOpen                Boolean
  yudisiumRegistrations YudisiumRegistration[]
}

model YudisiumRegistrationPeriod {
  id                    String                 @id @default(uuid())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  name                  String
  startDate             DateTime               @map("start_date") @db.Date
  endDate               DateTime               @map("end_date") @db.Date
  isOpen                Boolean
  yudisiumRegistrations YudisiumRegistration[]
}

model YudisiumRegistration {
  id                            String                         @id @default(uuid())
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  submittedAt                   DateTime?
  deletedAt                     DateTime?
  isDraft                       Boolean                        @default(true)
  // wajib
  programType                   String? // Reguler, Alih Jenjang
  tak                           Int?
  thesisTitleId                 String?
  thesisTitleEn                 String?
  isConfirmed                   Boolean? // Saya telah memastikan bahwa Judul Tugas Akhir yang saya inputkan sudah sesuai dengan yang tertera pada iGracias.
  sidangScheme                  String?
  cumlaudeScheme                String? // Non Cumlaude, Pengajuan Cumlaude, Pengajuan Summa Cumlaude
  // wajib jika memilih selain non cumlaude
  jalurNonYudisium              Json? // Contoh isi JSON: ["Publikasi Jurnal", "Pameran", "Lomba", "HKI"]
  eviden_cumlaude               String?                        @db.Text
  // wajib
  mahasiswa                     Mahasiswa?                     @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId                   String?
  dosenPembimbing1              Dosen?                         @relation("Pembimbing1YudisiumRegistrations", fields: [dosenPembimbing1Id], references: [id]) // Dosen Pembimbing 1
  dosenPembimbing1Id            String?
  dosenPembimbing2              Dosen?                         @relation("Pembimbing2YudisiumRegistrations", fields: [dosenPembimbing2Id], references: [id]) // Dosen Pembimbing 2
  dosenPembimbing2Id            String?
  yudisiumPeriod                YudisiumPeriod?                @relation(fields: [yudisiumPeriodId], references: [id])
  yudisiumPeriodId              String?
  yudisiumRegistrationPeriod    YudisiumRegistrationPeriod?    @relation(fields: [yudisiumRegistrationPeriodId], references: [id])
  yudisiumRegistrationPeriodId  String?
  yudisiumRegistrationUploads   YudisiumRegistrationUpload[]
  yudisiumRegistrationResponses YudisiumRegistrationResponse[]
}

// Upload Dokumen Persyaratan
model YudisiumRegistrationUpload {
  id                     String               @id @default(uuid())
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?
  name                   String
  filename               String
  slug                   String // misal: formValidasiDosenWali
  path                   String
  yudisiumRegistration   YudisiumRegistration @relation(fields: [yudisiumRegistrationId], references: [id], onDelete: Cascade)
  yudisiumRegistrationId String
}

model YudisiumRegistrationResponse {
  id                     String               @id @default(uuid())
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?
  message                String?
  isEdit                 DateTime?
  admin                  Admin                @relation(fields: [adminId], references: [id])
  adminId                String
  yudisiumRegistration   YudisiumRegistration @relation(fields: [yudisiumRegistrationId], references: [id], onDelete: Cascade)
  yudisiumRegistrationId String
}

model FormulirPenerbitanSktaUpload {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  name        String
  filename    String
  path        String
  mahasiswa   Mahasiswa @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId String
}

model DokumenValidasiSktaUpload {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  name        String
  filename    String
  path        String
  mahasiswa   Mahasiswa @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId String
}

model SklUpload {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  name        String
  filename    String
  path        String
  mahasiswa   Mahasiswa @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId String
}

model TranskripUpload {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  name        String
  filename    String
  path        String
  mahasiswa   Mahasiswa @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId String
}

model TemplateUpload {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  name      String
  slug      String    @unique // contoh: formulirPenerbitanSkta
  filename  String
  path      String
  isPublish Boolean   @default(true)
}
