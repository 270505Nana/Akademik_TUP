// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MAHASISWA
  DOSEN
  ADMIN
}

model User {
  id        String     @id @default(uuid())
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")
  name      String
  email     String     @unique
  password  String
  phone     String?    @unique
  role      Role?
  admin     Admin?
  dosen     Dosen?
  mahasiswa Mahasiswa?

  @@index([role])
  @@index([deletedAt])
  @@map("user")
}

// Master Data Admin
model Admin {
  id                    String                 @id @default(uuid())
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String                 @unique @map("user_id")
  permohonanSkta        PermohonanSkta[]
  sidangRegistrations   SidangRegistration[]
  yudisiumRegistrations YudisiumRegistration[]

  @@index([deletedAt])
  @@map("admin")
}

// Master Data Dosen
model ResearchGroup {
  id                  String               @id @default(uuid())
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  name                String
  isActive            Boolean              @default(true) @map("is_active")
  dosen               Dosen[]
  permohonanSkta      PermohonanSkta[]
  sidangRegistrations SidangRegistration[]

  @@index([deletedAt])
  @@index([isActive])
  @@map("research_group")
}

model Dosen {
  id                               String                 @id @default(uuid())
  createdAt                        DateTime               @default(now()) @map("created_at")
  updatedAt                        DateTime               @updatedAt @map("updated_at")
  deletedAt                        DateTime?              @map("deleted_at")
  nip                              String                 @unique
  nidn                             String?                @unique
  kodeDosen                        String                 @map("kode_dosen")
  isKetuaKK                        Boolean                @default(false) @map("is_ketua_kk")
  researchGroup                    ResearchGroup          @relation(fields: [researchGroupId], references: [id])
  researchGroupId                  String                 @map("research_group_id")
  user                             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                           String                 @unique @map("user_id")
  mahasiswa                        Mahasiswa[]
  waliSidangRegistrations          SidangRegistration[]   @relation("WaliSidangRegistrations")
  pembimbing1SidangRegistrations   SidangRegistration[]   @relation("Pembimbing1SidangRegistrations")
  pembimbing2SidangRegistrations   SidangRegistration[]   @relation("Pembimbing2SidangRegistrations")
  waliYudisiumRegistrations        YudisiumRegistration[] @relation("WaliYudisiumRegistrations")
  pembimbing1YudisiumRegistrations YudisiumRegistration[] @relation("Pembimbing1YudisiumRegistrations")
  pembimbing2YudisiumRegistrations YudisiumRegistration[] @relation("Pembimbing2YudisiumRegistrations")
  pembimbing1Skta                  PermohonanSkta[]       @relation("Pembimbing1Skta")
  pembimbing2Skta                  PermohonanSkta[]       @relation("Pembimbing2Skta")
  penguji1                         SidangRegistration[]   @relation("Penguji1")
  penguji2                         SidangRegistration[]   @relation("Penguji2")

  @@index([researchGroupId])
  @@index([deletedAt])
  @@map("dosen")
}

// Master Data Mahasiswa
model Faculty {
  id            String         @id @default(uuid())
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")
  name          String
  isActive      Boolean        @default(true) @map("is_active")
  studyPrograms StudyProgram[]

  @@index([deletedAt])
  @@index([isActive])
  @@map("faculty")
}

model StudyProgram {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at")
  name      String
  isActive  Boolean     @default(true) @map("is_active")
  faculty   Faculty     @relation(fields: [facultyId], references: [id])
  facultyId String      @map("faculty_id")
  mahasiswa Mahasiswa[]

  @@index([facultyId])
  @@index([deletedAt])
  @@index([isActive])
  @@map("study_program")
}

model Mahasiswa {
  id                    String                 @id @default(uuid())
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  nim                   String                 @unique
  kelasAsal             String                 @map("kelas_asal")
  tahunAngkatan         Int                    @map("tahun_angkatan")
  sks                   Int?
  ipk                   Float?
  tak                   Int?
  studyProgram          StudyProgram           @relation(fields: [studyProgramId], references: [id])
  studyProgramId        String                 @map("study_program_id")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String                 @unique @map("user_id")
  dosenWali             Dosen                  @relation(fields: [dosenWaliId], references: [id])
  dosenWaliId           String                 @map("dosen_wali_id")
  sidangRegistrations   SidangRegistration[]
  yudisiumRegistrations YudisiumRegistration[]
  permohonanSkta        PermohonanSkta[]
  berkasMahasiswa       BerkasMahasiswa[]

  @@index([studyProgramId])
  @@index([dosenWaliId])
  @@index([tahunAngkatan])
  @@index([deletedAt])
  @@map("mahasiswa")
}

model DokumenPersyaratanBerkas {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  name       String // Nama Berkas
  code       String    @unique
  category   String // Sidang Reguler / Non Sidang Publikasi Jurnal / Non Sidang Proceeding International / Yudisium
  filepath   String?
  isPublish  Boolean   @default(false) @map("is_publish")
  isRequired Boolean   @default(true) @map("is_required")
  queue      Int       @default(1)

  @@index([category])
  @@index([isPublish])
  @@index([deletedAt])
  @@map("dokumen_persyaratan_berkas")
}

// Permohonan Surat Keputusan TA
model PermohonanSkta {
  id                       String         @id @default(uuid())
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")
  deletedAt                DateTime?      @map("deleted_at")
  // Buat Permohonan
  isDraft                  Boolean        @default(true) @map("is_draft")
  category                 String // Buat baru, Pembaruan Ganti Judul, Pembaruan Ganti Dospem, Pembaruan Ganti Judul dan Dospem, Perpanjangan
  mahasiswa                Mahasiswa?     @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade) // NIM, Prodi, No HP
  mahasiswaId              String?        @map("mahasiswa_id")
  judulProposalIndonesia   String?        @map("judul_proposal_indonesia")
  judulProposalInggris     String?        @map("judul_proposal_inggris")
  dosenPembimbing1         Dosen?         @relation("Pembimbing1Skta", fields: [dosenPembimbing1Id], references: [id]) // Nama, Kode, Kelompok Keilmuan (Research Group) Dosen Pembimbing 1
  dosenPembimbing1Id       String?        @map("dosen_pembimbing_1_id")
  dosenPembimbing2         Dosen?         @relation("Pembimbing2Skta", fields: [dosenPembimbing2Id], references: [id]) // Nama, Kode Dosen Pembimbing 2
  dosenPembimbing2Id       String?        @map("dosen_pembimbing_2_id")
  researchGroup            ResearchGroup? @relation(fields: [researchGroupId], references: [id])
  researchGroupId          String?        @map("research_group_id")
  evidenceUploadPath       String?        @map("evidence_upload_path")
  // Setujui Permohonan
  hasUploadedFinalProposal Boolean?       @map("has_uploaded_final_proposal")
  hasTakenLanguageTest     Boolean?       @map("has_taken_language_test")
  sktaUploadPath           String?        @map("skta_upload_path")
  expDate                  DateTime?      @map("exp_date") @db.Date
  // Tolak Permohonan
  wasRejectedBefore        Boolean        @default(false) @map("was_rejected_before")
  message                  String?
  isEdit                   DateTime?      @map("is_edit")
  admin                    Admin?         @relation(fields: [adminId], references: [id])
  adminId                  String?        @map("admin_id")

  @@index([mahasiswaId])
  @@index([dosenPembimbing1Id])
  @@index([dosenPembimbing2Id])
  @@index([researchGroupId])
  @@index([adminId])
  @@index([deletedAt])
  @@map("permohonan_skta")
}

// Daftar Sidang
model SidangPeriod {
  id                        String               @id @default(uuid())
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  deletedAt                 DateTime?            @map("deleted_at")
  name                      String
  category                  String // tipe aktivitas: pendaftaran sidang / sidang
  period                    String // nama periode: 2026/2027
  startDate                 DateTime             @map("start_date")
  endDate                   DateTime             @map("end_date")
  isOpen                    Boolean              @default(false) @map("is_open")
  sidangRegistrationPeriods SidangRegistration[] @relation("SidangRegistrationPeriod")
  sidangPeriods             SidangRegistration[] @relation("SidangPeriod")

  @@index([category])
  @@index([period])
  @@index([isOpen])
  @@index([deletedAt])
  @@map("sidang_period")
}

model SidangRegistration {
  id                         String                     @id @default(uuid())
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")
  deletedAt                  DateTime?                  @map("deleted_at")
  // draft
  isDraft                    Boolean                    @default(true) @map("is_draft")
  mahasiswa                  Mahasiswa?                 @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId                String?                    @map("mahasiswa_id")
  program                    String? // Reguler / Alih Jenjang
  dosenWali                  Dosen?                     @relation("WaliSidangRegistrations", fields: [dosenWaliId], references: [id]) // Dosen Wali 1
  dosenWaliId                String?                    @map("dosen_wali_id")
  sks                        Int?
  ipk                        Float?
  tak                        Int?
  sktaExpDate                DateTime?                  @map("skta_exp_date")
  judulTugasAkhirIndonesia   String?                    @map("judul_tugas_akhir_indonesia")
  judulTugasAkhirInggris     String?                    @map("judul_tugas_akhir_inggris")
  dosenPembimbing1           Dosen?                     @relation("Pembimbing1SidangRegistrations", fields: [dosenPembimbing1Id], references: [id]) // Dosen Pembimbing 1
  dosenPembimbing1Id         String?                    @map("dosen_pembimbing_1_id")
  dosenPembimbing2           Dosen?                     @relation("Pembimbing2SidangRegistrations", fields: [dosenPembimbing2Id], references: [id]) // Dosen Pembimbing 2
  dosenPembimbing2Id         String?                    @map("dosen_pembimbing_2_id")
  researchGroup              ResearchGroup?             @relation(fields: [researchGroupId], references: [id])
  researchGroupId            String?                    @map("research_group_id")
  skemaSidang                String?                    @map("skema_sidang") // Reguler, Non Sidang, Capstone, Sidang Khusus Prodi
  jalurNonSidang             String[]                   @map("jalur_non_sidang") // Contoh isi JSON: ["Publikasi Jurnal", "Proceeding International", "HKI"]
  lulusTesBahasa             Boolean?                   @map("lulus_tes_bahasa")
  // submited
  submittedAt                DateTime?                  @map("submitted_at")
  sidangRegistrationPeriod   SidangPeriod?              @relation("SidangRegistrationPeriod", fields: [sidangRegistrationPeriodId], references: [id])
  sidangRegistrationPeriodId String?                    @map("sidang_registration_period_id")
  // Setuju
  sidangPeriod               SidangPeriod?              @relation("SidangPeriod", fields: [sidangPeriodId], references: [id])
  sidangPeriodId             String?                    @map("sidang_period_id")
  // Penjadwalan
  tglSidang                  DateTime?                  @map("tgl_sidang")
  ruanganSidang              Ruangan?                   @relation(fields: [ruanganSidangId], references: [id])
  ruanganSidangId            String?                    @map("ruangan_sidang_id")
  dosenPenguji1              Dosen?                     @relation("Penguji1", fields: [dosenPenguji1Id], references: [id]) // Dosen Penguji 1
  dosenPenguji1Id            String?                    @map("dosen_penguji_1_id")
  dosenPenguji2              Dosen?                     @relation("Penguji2", fields: [dosenPenguji2Id], references: [id]) // Dosen Penguji 2
  dosenPenguji2Id            String?                    @map("dosen_penguji_2_id")
  // Tolak Permohonan
  message                    String?
  isEdit                     DateTime?                  @map("is_edit")
  admin                      Admin?                     @relation(fields: [adminId], references: [id])
  adminId                    String?                    @map("admin_id")
  sidangRegistrationUploads  SidangRegistrationUpload[]

  @@index([mahasiswaId])
  @@index([dosenWaliId])
  @@index([dosenPembimbing1Id])
  @@index([dosenPembimbing2Id])
  @@index([researchGroupId])
  @@index([sidangRegistrationPeriodId])
  @@index([sidangPeriodId])
  @@index([ruanganSidangId])
  @@index([dosenPenguji1Id])
  @@index([dosenPenguji2Id])
  @@index([adminId])
  @@index([isDraft])
  @@index([deletedAt])
  @@map("sidang_registration")
}

// Upload Dokumen Persyaratan
model SidangRegistrationUpload {
  id                   String             @id @default(uuid())
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  deletedAt            DateTime?          @map("deleted_at")
  // mahasiswa via sistem
  name                 String // Nama Berkas
  category             String
  filepath             String
  // admin
  isValid              Boolean?           @map("is_valid")
  sidangRegistration   SidangRegistration @relation(fields: [sidangRegistrationId], references: [id], onDelete: Cascade)
  sidangRegistrationId String             @map("sidang_registration_id")

  @@index([sidangRegistrationId])
  @@index([category])
  @@index([deletedAt])
  @@map("sidang_registration_upload")
}

// Daftar Yudisium
model YudisiumPeriod {
  id                          String                 @id @default(uuid())
  createdAt                   DateTime               @default(now()) @map("created_at")
  updatedAt                   DateTime               @updatedAt @map("updated_at")
  deletedAt                   DateTime?              @map("deleted_at")
  name                        String
  category                    String // tipe aktivitas: pendaftaran yudisium / yudisium
  period                      String // nama periode: 2026/2027
  startDate                   DateTime               @map("start_date")
  endDate                     DateTime               @map("end_date")
  isOpen                      Boolean                @default(false) @map("is_open")
  yudisiumRegistrationPeriods YudisiumRegistration[] @relation("YudisiumRegistrationPeriod")
  yudisiumPeriods             YudisiumRegistration[] @relation("YudisiumPeriod")

  @@index([category])
  @@index([period])
  @@index([isOpen])
  @@index([deletedAt])
  @@map("yudisium_period")
}

model YudisiumRegistration {
  id                           String                       @id @default(uuid())
  createdAt                    DateTime                     @default(now()) @map("created_at")
  updatedAt                    DateTime                     @updatedAt @map("updated_at")
  deletedAt                    DateTime?                    @map("deleted_at")
  // draft
  isDraft                      Boolean                      @default(true) @map("is_draft")
  // wajib
  mahasiswa                    Mahasiswa?                   @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId                  String?                      @map("mahasiswa_id")
  program                      String? // Reguler / Alih Jenjang
  dosenWali                    Dosen?                       @relation("WaliYudisiumRegistrations", fields: [dosenWaliId], references: [id]) // Dosen Wali 1
  dosenWaliId                  String?                      @map("dosen_wali_id")
  judulTugasAkhirIndonesia     String?                      @map("judul_tugas_akhir_indonesia")
  judulTugasAkhirInggris       String?                      @map("judul_tugas_akhir_inggris")
  tak                          Int?
  tglSidang                    DateTime?                    @map("tgl_sidang")
  skemaSidang                  String?                      @map("skema_sidang") // Reguler, Non Sidang, Capstone, Sidang Khusus Prodi
  pengajuanCumlaude            String?                      @map("pengajuan_cumlaude")
  skemaCumlaude                String?                      @map("skema_cumlaude")
  evidenCumlaude               String?                      @map("eviden_cumlaude") @db.Text
  berminatWirausaha            Boolean?                     @map("berminat_wirausaha")
  dosenPembimbing1             Dosen?                       @relation("Pembimbing1YudisiumRegistrations", fields: [dosenPembimbing1Id], references: [id]) // Dosen Pembimbing 1
  dosenPembimbing1Id           String?                      @map("dosen_pembimbing_1_id") // di form yang baru tidak menyertakan Dospem 1
  dosenPembimbing2             Dosen?                       @relation("Pembimbing2YudisiumRegistrations", fields: [dosenPembimbing2Id], references: [id]) // Dosen Pembimbing 2
  dosenPembimbing2Id           String?                      @map("dosen_pembimbing_2_id") // di form yang baru tidak menyertakan Dospem 2
  // submitted
  submittedAt                  DateTime?                    @map("submitted_at")
  yudisiumRegistrationPeriod   YudisiumPeriod?              @relation("YudisiumRegistrationPeriod", fields: [yudisiumRegistrationPeriodId], references: [id])
  yudisiumRegistrationPeriodId String?                      @map("yudisium_registration_period_id")
  // Setuju
  yudisiumPeriod               YudisiumPeriod?              @relation("YudisiumPeriod", fields: [yudisiumPeriodId], references: [id])
  yudisiumPeriodId             String?                      @map("yudisium_period_id")
  // Tolak Permohonan
  message                      String?
  isEdit                       DateTime?                    @map("is_edit")
  admin                        Admin?                       @relation(fields: [adminId], references: [id])
  adminId                      String?                      @map("admin_id")
  yudisiumRegistrationUploads  YudisiumRegistrationUpload[]

  @@index([mahasiswaId])
  @@index([dosenWaliId])
  @@index([dosenPembimbing1Id])
  @@index([dosenPembimbing2Id])
  @@index([yudisiumRegistrationPeriodId])
  @@index([yudisiumPeriodId])
  @@index([adminId])
  @@index([isDraft])
  @@index([deletedAt])
  @@map("yudisium_registration")
}

// Upload Dokumen Persyaratan
model YudisiumRegistrationUpload {
  id                     String               @id @default(uuid())
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  deletedAt              DateTime?            @map("deleted_at")
  // mahasiswa via sistem
  name                   String // Nama Berkas
  category               String // Evidence Cumlaude / Dokumen Kelengkapan Yudisium
  filepath               String
  // admin
  isValid                Boolean?             @map("is_valid")
  yudisiumRegistration   YudisiumRegistration @relation(fields: [yudisiumRegistrationId], references: [id], onDelete: Cascade)
  yudisiumRegistrationId String               @map("yudisium_registration_id")

  @@index([yudisiumRegistrationId])
  @@index([category])
  @@index([deletedAt])
  @@map("yudisium_registration_upload")
}

model BerkasMahasiswa {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  name        String // Nama Berkas
  category    String // SKL, Transkrip, Dokumen Validasi Skta, Formulir Penerbitan Skta
  filepath    String
  mahasiswa   Mahasiswa @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId String    @map("mahasiswa_id")

  @@index([mahasiswaId])
  @@index([category])
  @@index([deletedAt])
  @@map("berkas_mahasiswa")
}

model Ruangan {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  name      String
  gedung    String
  isActive  Boolean   @default(true) @map("is_active")

  sidangRegistrations SidangRegistration[]

  @@index([gedung])
  @@index([isActive])
  @@index([deletedAt])
  @@map("ruangan")
}
