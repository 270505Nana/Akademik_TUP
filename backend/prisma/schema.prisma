model YudisiumRegistration {
  id                           String                       @id @default(uuid())
  createdAt                    DateTime                     @default(now()) @map("created_at")
  updatedAt                    DateTime                     @updatedAt @map("updated_at")
  deletedAt                    DateTime?                    @map("deleted_at")
  // draft
  isDraft                      Boolean                      @default(true) @map("is_draft")
  // wajib
  mahasiswa                    Mahasiswa?                   @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade)
  mahasiswaId                  String?                      @map("mahasiswa_id")
  program                      String? // Reguler / Alih Jenjang
  dosenWali                    Dosen?                       @relation("WaliYudisiumRegistrations", fields: [dosenWaliId], references: [id]) // Dosen Wali 1
  dosenWaliId                  String?                      @map("dosen_wali_id")
  judulTugasAkhirIndonesia     String?                      @map("judul_tugas_akhir_indonesia")
  judulTugasAkhirInggris       String?                      @map("judul_tugas_akhir_inggris")
  tak                          Int?
  skemaSidang                  String?                      @map("skema_sidang") // Reguler, Non Sidang, Capstone, Sidang Khusus Prodi
  pengajuanCumlaude            String?                      @map("pengajuan_cumlaude")
  skemaCumlaude                String?                      @map("skema_cumlaude")
  evidenCumlaude               String?                      @map("eviden_cumlaude") @db.Text
  dosenPembimbing1             Dosen?                       @relation("Pembimbing1YudisiumRegistrations", fields: [dosenPembimbing1Id], references: [id]) // Dosen Pembimbing 1
  dosenPembimbing1Id           String?                      @map("dosen_pembimbing_1_id") // di form yang baru tidak menyertakan Dospem 1
  dosenPembimbing2             Dosen?                       @relation("Pembimbing2YudisiumRegistrations", fields: [dosenPembimbing2Id], references: [id]) // Dosen Pembimbing 2
  dosenPembimbing2Id           String?                      @map("dosen_pembimbing_2_id") // di form yang baru tidak menyertakan Dospem 2
  // submitted
  submittedAt                  DateTime?                    @map("submitted_at")
  yudisiumRegistrationPeriod   YudisiumPeriod?              @relation("YudisiumRegistrationPeriod", fields: [yudisiumRegistrationPeriodId], references: [id])
  yudisiumRegistrationPeriodId String?                      @map("yudisium_registration_period_id")
  // Setuju
  yudisiumPeriod               YudisiumPeriod?              @relation("YudisiumPeriod", fields: [yudisiumPeriodId], references: [id])
  yudisiumPeriodId             String?                      @map("yudisium_period_id")
  // Tolak Permohonan
  message                      String?
  isEdit                       DateTime?                    @map("is_edit")
  admin                        Admin                        @relation(fields: [adminId], references: [id])
  adminId                      String                       @map("admin_id")
  yudisiumRegistrationUploads  YudisiumRegistrationUpload[]
  // yudisiumRegistrationResponses YudisiumRegistrationResponse[]

  @@map("yudisium_registration")
}

// Upload Dokumen Persyaratan
model YudisiumRegistrationUpload {
  id                     String               @id @default(uuid())
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  deletedAt              DateTime?            @map("deleted_at")
  // mahasiswa via sistem
  name                   String // Nama Berkas
  category               String // Evidence Cumlaude / Dokumen Kelengkapan Yudisium
  filepath               String
  // admin
  isValid                Boolean?             @map("is_valid")
  yudisiumRegistration   YudisiumRegistration @relation(fields: [yudisiumRegistrationId], references: [id], onDelete: Cascade)
  yudisiumRegistrationId String               @map("yudisium_registration_id")

  @@map("yudisium_registration_upload")
}

