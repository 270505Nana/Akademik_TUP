// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MAHASISWA
  DOSEN
  ADMIN
}

model User {
  id        String     @id @default(uuid())
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")
  name      String
  email     String     @unique
  password  String
  phone     String?    @unique
  role      Role?
  admin     Admin?
  dosen     Dosen?
  mahasiswa Mahasiswa?

  @@map("user")
}

// Master Data Admin
model Admin {
  id                    String                 @id @default(uuid())
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String                 @unique @map("user_id")
  // sktaResponses                 SktaResponse[]
  // sidangRegistrationResponses   SidangRegistrationResponse[]
  // yudisiumRegistrationResponses YudisiumRegistrationResponse[]
  permohonanSkta        PermohonanSkta[]
  sidangRegistrations   SidangRegistration[]
  yudisiumRegistrations YudisiumRegistration[]

  @@map("admin")
}

// Master Data Dosen
model ResearchGroup {
  id                  String               @id @default(uuid())
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  name                String
  isActive            Boolean              @default(true) @map("is_active")
  dosen               Dosen[]
  permohonanSkta      PermohonanSkta[]
  sidangRegistrations SidangRegistration[]

  @@map("research_group")
}

model Dosen {
  id                               String                 @id @default(uuid())
  createdAt                        DateTime               @default(now()) @map("created_at")
  updatedAt                        DateTime               @updatedAt @map("updated_at")
  deletedAt                        DateTime?              @map("deleted_at")
  nip                              String                 @unique
  nidn                             String?                @unique
  kodeDosen                        String                 @map("kode_dosen")
  researchGroup                    ResearchGroup          @relation(fields: [researchGroupId], references: [id])
  researchGroupId                  String                 @map("research_group_id")
  user                             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                           String                 @unique @map("user_id")
  mahasiswa                        Mahasiswa[]
  // pembimbing1SktaRequests          SktaRequest[]          @relation("Pembimbing1SktaRequests")
  // pembimbing2SktaRequests          SktaRequest[]          @relation("Pembimbing2SktaRequests")
  waliSidangRegistrations          SidangRegistration[]   @relation("WaliSidangRegistrations")
  pembimbing1SidangRegistrations   SidangRegistration[]   @relation("Pembimbing1SidangRegistrations")
  pembimbing2SidangRegistrations   SidangRegistration[]   @relation("Pembimbing2SidangRegistrations")
  waliYudisiumRegistrations        YudisiumRegistration[] @relation("WaliYudisiumRegistrations")
  pembimbing1YudisiumRegistrations YudisiumRegistration[] @relation("Pembimbing1YudisiumRegistrations")
  pembimbing2YudisiumRegistrations YudisiumRegistration[] @relation("Pembimbing2YudisiumRegistrations")
  pembimbing1Skta                  PermohonanSkta[]       @relation("Pembimbing1Skta")
  pembimbing2Skta                  PermohonanSkta[]       @relation("Pembimbing2Skta")

  @@map("dosen")
}

// Master Data Mahasiswa
model Faculty {
  id            String         @id @default(uuid())
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")
  name          String
  isActive      Boolean        @default(true) @map("is_active")
  studyPrograms StudyProgram[]

  @@map("faculty")
}

model StudyProgram {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at")
  name      String
  isActive  Boolean     @default(true) @map("is_active")
  faculty   Faculty     @relation(fields: [facultyId], references: [id])
  facultyId String      @map("faculty_id")
  mahasiswa Mahasiswa[]

  @@map("study_program")
}

model Mahasiswa {
  id                    String                 @id @default(uuid())
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  nim                   String                 @unique
  kelasAsal             String                 @map("kelas_asal")
  tahunAngkatan         Int                    @map("tahun_angkatan")
  sks                   Int?
  ipk                   Float?
  tak                   Int?
  studyProgram          StudyProgram           @relation(fields: [studyProgramId], references: [id])
  studyProgramId        String                 @map("study_program_id")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String                 @unique @map("user_id")
  dosenWali             Dosen                  @relation(fields: [dosenWaliId], references: [id])
  dosenWaliId           String                 @map("dosen_wali_id")
  // sktaRequests                  SktaRequest[]
  sidangRegistrations   SidangRegistration[]
  yudisiumRegistrations YudisiumRegistration[]
  // sktaResponses                 SktaResponse[]
  // sktaResponseUploads           SktaResponseUpload[]
  // sktaRequestUploads            SktaRequestUpload[]
  // sklUploads                    SklUpload[]
  // transkripUploads              TranskripUpload[]
  // dokumenValidasiSktaUploads    DokumenValidasiSktaUpload[]
  // formulirPenerbitanSktaUploads FormulirPenerbitanSktaUpload[]
  permohonanSkta        PermohonanSkta[]
  berkasMahasiswa       BerkasMahasiswa[]

  @@map("mahasiswa")
}

model DokumenPersyaratanBerkas {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  name      String // Nama Berkas
  code      String    @unique
  category  String // Sidang Reguler / Non Sidang Publikasi Jurnal / Non Sidang Proceeding International / Yudisium
  filepath  String
  isPublish Boolean   @default(true) @map("is_publish")

  @@map("dokumen_persyaratan_berkas")
}

// Permohonan Surat Keputusan TA
model PermohonanSkta {
  id                       String        @id @default(uuid())
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")
  deletedAt                DateTime?     @map("deleted_at")
  // Buat Permohonan
  category                 String // Buat baru, Pembaruan Ganti Judul, Pembaruan Ganti Dospem, Pembaruan Ganti Judul dan Dospem, Perpanjangan
  mahasiswa                Mahasiswa     @relation(fields: [mahasiswaId], references: [id], onDelete: Cascade) // NIM, Prodi, No HP
  mahasiswaId              String        @map("mahasiswa_id")
  judulProposalIndonesia   String        @map("judul_proposal_indonesia")
  judulProposalInggris     String        @map("judul_proposal_inggris")
  dosenPembimbing1         Dosen         @relation("Pembimbing1Skta", fields: [dosenPembimbing1Id], references: [id]) // Nama, Kode, Kelompok Keilmuan (Research Group) Dosen Pembimbing 1
  dosenPembimbing1Id       String        @map("dosen_pembimbing_1_id")
  dosenPembimbing2         Dosen         @relation("Pembimbing2Skta", fields: [dosenPembimbing2Id], references: [id]) // Nama, Kode Dosen Pembimbing 2
  dosenPembimbing2Id       String        @map("dosen_pembimbing_2_id")
  researchGroup            ResearchGroup @relation(fields: [researchGroupId], references: [id])
  researchGroupId          String        @map("research_group_id")
  evidenceUploadPath       String        @map("evidence_upload_path")
  // Setujui Permohonan
  hasUploadedFinalProposal Boolean?      @map("has_uploaded_final_proposal")
  hasTakenLanguageTest     Boolean?      @map("has_taken_language_test")
  sktaUploadPath           String?       @map("skta_upload_path")
  expDate                  DateTime?     @map("exp_date") @db.Date
  // Tolak Permohonan
  message                  String?
  isEdit                   DateTime?     @map("is_edit")
  admin                    Admin?        @relation(fields: [adminId], references: [id])
  adminId                  String?       @map("admin_id")

  @@map("permohonan_skta")
}

